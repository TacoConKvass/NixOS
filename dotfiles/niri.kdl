input {
    keyboard {
        // xkb { }
        numlock
    }
}

output "Smithay Winit Unknown" {
    mode "1920x1080@60"
    scale 0.8
}

binds {
    // help
    Mod+Shift+Slash  { show-hotkey-overlay; }

    // Apps
    Mod+T            { spawn "ghostty"; }
    Mod+Return       { spawn "fuzzel"; }

    // Manage windows
    Mod+K            { focus-column-right; }
    Mod+J            { focus-column-left; }
    Mod+Shift+K      { focus-workspace-up; }
    Mod+Shift+J      { focus-workspace-down; }
    Mod+Q            { close-window; }
    Mod+F            { maximize-column; }

    Mod+Shift+Q      { quit; }
}

hotkey-overlay {
    hide-not-bound
}
