font-size = 11

background = #080808
# background-opacity = .7
# background-blur = 40
window-decoration = none
window-padding-x = 8
window-padding-y = 8

# Split controls
keybind = alt+w=new_split:auto
keybind = alt+q=close_surface
keybind = alt+j=goto_split:previous
keybind = alt+k=goto_split:next

keybind = alt+r=reload_config
